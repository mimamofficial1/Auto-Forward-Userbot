{
  "name": "SilentXForwardBot",
  "description": "A Telegram Bot To Auto-Forward Channel Content Without The Forward Tag.",
  "keywords": [
    "telegram",
    "bot",
    "forward",
    "pyrogram"
  ],
  "repository": "https://github.com/NBBotz/Auto-Forward-Bot",
  "env": {
    "API_ID": {
      "description": "Get This Value From https://my.telegram.org/apps",
      "required": true
    },
    "API_HASH": {
      "description": "Get This Value From https://my.telegram.org/apps",
      "required": true
    },
    "BOT_TOKEN": {
      "description": "Get This Value From @BotFather",
      "required": true
    },
    "WEB_SERVER": {
      "description": "Enable Web Server For Keep-Alive",
      "value": "True",
      "required": false
    },
    "MONGO_URI": {
      "description": "MongoDB connection string",
      "required": true
    },
    "OWNER_ID": {
      "description": "Your Telegram user ID (owner / admin commands)",
      "required": false
    },
    "LOG_CHANNEL": {
      "description": "Channel ID for bot logs",
      "required": false
    }
  },
  "buildpacks": [
    {
      "url": "heroku/python"
    }
  ]
}
